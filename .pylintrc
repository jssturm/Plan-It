[MAIN]

# Django, Flask, or custom module patterns that may be imported late
init-hook='import sys; sys.path.append(".")'

# Exclude data migration scripts and test helper files from linting
ignore=data,test_travel.py

[MESSAGES CONTROL]

# Disable warnings that are acceptable for this project or are covered by
# other tooling. The goal is zero E (error) and F (fatal) issues; C/W/R
# warnings are informational and may be selectively disabled.
disable=
    C0103,  # invalid-name
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    C0301,  # line-too-long
    C0302,  # too-many-lines
    C0303,  # trailing-whitespace
    C0304,  # missing-final-newline
    C0413,  # wrong-import-position
    C0415,  # import-outside-toplevel
    E0611,  # no-name-in-module
    R0914,  # too-many-locals
    W0404,  # reimported
    W0603,  # global-statement
    W0611,  # unused-import
    W0612,  # unused-variable
    W0613,  # unused-argument
    W0621,  # redefined-outer-name
    W0707,  # raise-missing-from
    W0718,  # broad-exception-caught
    W1309,  # f-string-without-interpolation
    W1404,  # implicit-str-concat
    W1514,  # unspecified-encoding

[REPORTS]
output-format=colorized
score=no

[FORMAT]
max-line-length=100
good-names=i,j,k,ex,_,s,m,e,r,h
