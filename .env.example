# Plan-It — Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: No API keys required. The app uses DuckDuckGo for web research
# and builds itineraries entirely within your installed environment.

# API authentication (optional)
# When set, all endpoints require Authorization: Bearer <key>
# Leave empty for development mode (no auth required)
TRAVEL_API_KEY=

# Rate limiting (optional — default shown)
# Format: "N/minute" or "N/second"
RATE_LIMIT=10/minute

# CORS origins (optional — comma-separated, default allows all)
CORS_ORIGINS=*

# Search engine settings (optional)
SEARCH_MAX_RESULTS=12
SEARCH_RATE_LIMIT_S=1.2

# Maximum user input length in characters (optional)
MAX_INPUT_LENGTH=2000

# Environment label (optional)
ENVIRONMENT=production

# Server host and port (optional — defaults shown)
TRAVEL_HOST=0.0.0.0
TRAVEL_PORT=8000

# LLM integration (optional — enables AI-powered intent parsing)
# When set, natural-language trip descriptions are parsed with DeepSeek
# for higher accuracy (multi-stop trips, date parsing, preference extraction).
# Without it, the deterministic regex parser is used as fallback.
# Get a free key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Weather integration (always enabled — uses free Open-Meteo API, no key)
# Set to "false" to disable weather forecasts in itineraries.
WEATHER_ENABLED=true

# Crowd prediction (always enabled — uses internal calendar data)
# Set to "false" to disable crowd-level estimates and tips.
CROWD_ENABLED=true
